APP_NAME=MyTicket API
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json
# Set a long random value when /metrics is reachable outside a private network.
METRICS_BEARER_TOKEN=
# Set a private-network port to expose metrics from the standalone Worker process.
AGENT_WORKER_METRICS_PORT=0

DATABASE_URL=mysql+asyncmy://myticket:replace-with-a-local-database-password@127.0.0.1:3306/myticket
DATABASE_ECHO=false
DATABASE_POOL_RECYCLE_SECONDS=1800

REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_BACKEND=memory
# local: Redis 故障时退回单进程限流；deny: 直接返回 503
RATE_LIMIT_REDIS_FAILURE_MODE=local
RATE_LIMIT_KEY_PREFIX=myticket:rate-limit
AGENT_RATE_LIMIT_PER_MINUTE=20
AUTH_ACCOUNT_RATE_LIMIT_PER_MINUTE=10
AUTH_IP_RATE_LIMIT_PER_MINUTE=60
AGENT_WORKER_POLL_SECONDS=1
AGENT_TASK_LEASE_SECONDS=60
AGENT_TASK_MAX_ATTEMPTS=3

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_NAME=myticket_session
# Local HTTP development only. Set true behind production HTTPS.
AUTH_COOKIE_SECURE=false

LLM_PROVIDER=qwen
LLM_ENABLED=false

DASHSCOPE_API_KEY=

QWEN_MODEL=qwen3.8-max

QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CLASSIFICATION_TIMEOUT_SECONDS=15
CLASSIFICATION_MAX_RETRIES=2
DECISION_TIMEOUT_SECONDS=15
DECISION_MAX_RETRIES=2
REPLY_TIMEOUT_SECONDS=15
REPLY_MAX_RETRIES=2
REVIEW_TIMEOUT_SECONDS=15
REVIEW_MAX_RETRIES=1
LLM_RETRY_DELAY_SECONDS=1
CLASSIFICATION_MAX_OUTPUT_TOKENS=300
DECISION_MAX_OUTPUT_TOKENS=500
REPLY_MAX_OUTPUT_TOKENS=800
REVIEW_MAX_OUTPUT_TOKENS=300
EMBEDDING_ENABLED=false
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=512
EMBEDDING_TIMEOUT_SECONDS=10
QDRANT_ENABLED=false
QDRANT_URL=http://localhost:6333
# Local Qdrant does not require a key. Set this only for a secured deployment.
QDRANT_API_KEY=
QDRANT_COLLECTION=myticket_knowledge
QDRANT_TIMEOUT_SECONDS=5
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=100
QDRANT_HNSW_EF_SEARCH=64
RAG_TOP_K=3
RAG_CANDIDATE_K=10
KNOWLEDGE_CHUNK_SIZE=500
KNOWLEDGE_CHUNK_OVERLAP=80
KNOWLEDGE_MAX_CHUNKS=200
KNOWLEDGE_EMBEDDING_TOTAL_TIMEOUT_SECONDS=60

CONTEXT_MAX_HISTORY_CHARACTERS=6000
CONTEXT_MAX_MESSAGES=12
CONTEXT_MAX_TOOL_RESULTS=3
CONTEXT_MAX_CHARACTERS=9000
CONTEXT_MAX_MEMORY_CHARACTERS=1500
CONTEXT_MAX_KNOWLEDGE_CHARACTERS=3000

# Local demo data only
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=replace-with-a-local-demo-user-password
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=replace-with-a-local-demo-admin-password
DEMO_AGENT_EMAIL=agent@example.com
DEMO_AGENT_PASSWORD=replace-with-a-local-demo-agent-password
